{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-insiders-x64",
      "displayName": "Visual Studio 2026 Insiders x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145,host=x64",
      "binaryDir": "${sourceDir}/build/vs2026-insiders-x64",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_GENERATOR_INSTANCE": "$penv{ProgramFiles}/Microsoft Visual Studio/18/Insiders"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal (Apple Silicon + Intel)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-universal",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-insiders-x64",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "vs2026-insiders-x64",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-universal",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-insiders-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-universal",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}